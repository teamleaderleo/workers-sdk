new file mode 100644
--- /dev/null
+++ b/packages/vite-plugin-cloudflare/src/build-context.ts
@@ -0,0 +1,19 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+
+const viteBuildContext = new AsyncLocalStorage<boolean>();
+
+/**
+ * Runs nested preview/config work as part of one Vite build operation without
+ * leaving a process-wide marker behind for unrelated operations.
+ */
+export function runInViteBuildContext<T>(operation: () => T): T {
+	return viteBuildContext.run(true, operation);
+}
+
+/** Whether the current asynchronous operation belongs to a Vite build. */
+export function isViteBuildContext(): boolean {
+	return viteBuildContext.getStore() === true;
+}
+
