@@ -3,8 +3,12 @@ import { spawn } from "node:child_process";
 import { UserError } from "@cloudflare/workers-utils";
 import { ImageRegistriesService, ImageRegistryPermissions } from "./client";
 import { OpenAPI } from "./client/core/OpenAPI";
+import { request } from "./client/core/request";
+import type { AccountRegistryToken } from "./client/models/AccountRegistryToken";
+import type { ImageRegistryCredentialsConfiguration } from "./client/models/ImageRegistryCredentialsConfiguration";
+import type { OpenAPIConfig } from "./client/core/OpenAPI";
+import type { WranglerLogger } from "./types";
+
+export interface RegistryCredentialsClient {
+	generateImageRegistryCredentials(
+		domain: string,
+		requestBody: ImageRegistryCredentialsConfiguration
+	): Promise<AccountRegistryToken>;
+}
+
+export function createRegistryCredentialsClient(options: {
+	accountId: string;
+	apiToken: string;
+	logger: WranglerLogger;
+	apiBase?: string;
+}): RegistryCredentialsClient {
+	// Build a closed config from constants and operation inputs. Never spread the
+	// mutable generated OpenAPI singleton: TOKEN, USERNAME, PASSWORD, HEADERS,
+	// LOGGER, or ENCODE_PATH may have been changed by another caller.
+	const config: OpenAPIConfig = {
+		BASE: `${options.apiBase ?? "https://api.cloudflare.com/client/v4"}/accounts/${options.accountId}/containers`,
+		VERSION: "1.0.0",
+		WITH_CREDENTIALS: false,
+		CREDENTIALS: "omit",
+		TOKEN: undefined,
+		USERNAME: undefined,
+		PASSWORD: undefined,
+		HEADERS: { Authorization: `Bearer ${options.apiToken}` },
+		ENCODE_PATH: encodeURI,
+		LOGGER: options.logger,
+	};
+	return {
+		generateImageRegistryCredentials(domain, requestBody) {
+			return request<AccountRegistryToken>(config, {
+				method: "POST",
+				url: "/registries/{domain}/credentials",
+				path: { domain },
+				body: requestBody,
+				mediaType: "application/json",
+				errors: {
+					400: "Bad Request",
+					404: "The image registry does not exist",
+					409: "The registry is public",
+					500: "Internal Error",
+				},
+			});
+		},
+	};
+}
