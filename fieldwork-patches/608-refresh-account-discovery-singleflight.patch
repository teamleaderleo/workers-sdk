+	function refreshToken(profile?: string): Promise<boolean> {
+		const resolvedProfile = profile ?? activeProfile;
+		const storage = getStorage(resolvedProfile);
+		const clientId = getClientId();
+		const key = JSON.stringify([
+			resolvedProfile,
+			storage.path(),
+			clientId,
+			getTokenUrlFromEnv(),
+		]);
+		const existing = refreshes.get(key);
+		if (existing) {
+			return existing;
+		}
+
+		const pending = performTokenRefresh(storage, clientId).finally(() => {
+			if (refreshes.get(key) === pending) {
+				refreshes.delete(key);
+			}
+		});
+		refreshes.set(key, pending);
+		return pending;
+	}
